<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Extender vista de formulario de contacto -->
    <record id="view_partner_form_verifacti" model="ir.ui.view">
        <field name="name">res.partner.form.verifacti</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='category_id']" position="after">
                <field name="is_verifacti_customer"/>
            </xpath>
            <div name="button_box" position="inside">
                <button name="action_view_verifacti_invoices" type="object"
                        class="oe_stat_button" icon="fa-file-text-o"
                        attrs="{'invisible': [('verifacti_invoice_count', '=', 0)]}">
                    <field name="verifacti_invoice_count" widget="statinfo"
                           string="Facturas VeriFactu"/>
                </button>
            </div>
        </field>
    </record>
</odoo>
