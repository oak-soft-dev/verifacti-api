<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Extender vista de configuración -->
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.verifacti</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('settings')]" position="inside">
                <div class="app_settings_block" data_key="verifacti_api" string="Verifacti API">
                    <h2>Configuración de Verifacti API</h2>
                    <div class="row mt16 o_settings_container">
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane"/>
                            <div class="o_setting_right_pane">
                                <div class="content-group">
                                    <div class="mt16">
                                        <label for="verifacti_api_config_id" string="Configuración API por Defecto"/>
                                        <field name="verifacti_api_config_id"
                                               options="{'no_create': True, 'no_open': True}"
                                               placeholder="Seleccione una configuración de API..."/>
                                        <div class="text-muted">
                                            Configuración de API Verifacti que se usará por defecto para esta compañía
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-12">
                            <button name="action_open_verifacti_api_configs"
                                    string="Gestionar Configuraciones de API"
                                    type="object"
                                    class="btn-primary"
                                    icon="fa-cog"/>
                            <div class="text-muted mt8">
                                Puede crear y gestionar múltiples configuraciones de API (desarrollo, producción, etc.)
                                desde el menú <strong>Verifacti → Configuración → Configuraciones API</strong>
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
