<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Vista Form de Facturas - Extensión VeriFactu -->
    <record id="view_move_form_verifacti" model="ir.ui.view">
        <field name="name">account.move.form.verifacti</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">

            <!-- Agregar botones en el header (solo para facturas de cliente) -->
            <xpath expr="//header" position="inside">
                <button name="action_send_to_verifacti"
                        string="Enviar a VeriFactu"
                        type="object"
                        class="btn-primary"
                        invisible="move_type not in ['out_invoice', 'out_refund'] or state != 'posted' or (verifacti_state not in ['draft', 'error'] and move_type != 'out_refund')"
                        groups="base.group_user"/>

                <button name="action_check_verifacti_status"
                        string="Verificar Estado"
                        type="object"
                        invisible="move_type not in ['out_invoice', 'out_refund'] or not verifacti_uuid"
                        groups="base.group_user"/>

                <button name="action_download_verifacti_xmls"
                        string="Descargar XMLs"
                        type="object"
                        invisible="move_type not in ['out_invoice', 'out_refund'] or not verifacti_uuid"
                        groups="base.group_user"/>

                <button name="action_cancel_verifacti"
                        string="Anular en VeriFactu"
                        type="object"
                        confirm="¿Está seguro de que desea anular esta factura en VeriFactu?"
                        invisible="move_type not in ['out_invoice', 'out_refund'] or not verifacti_uuid or verifacti_state == 'cancelled'"
                        groups="base.group_user"/>

                <field name="verifacti_state"
                       widget="statusbar"
                       statusbar_visible="draft,sent,pending,correct"
                       invisible="move_type not in ['out_invoice', 'out_refund']"/>
            </xpath>

            <!-- Agregar botón inteligente para código QR -->
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_download_verifacti_xmls"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-qrcode"
                        invisible="not verifacti_qr">
                    <div class="o_stat_info">
                        <span class="o_stat_text">QR VeriFactu</span>
                    </div>
                </button>
            </xpath>

            <!-- Agregar pestaña VeriFactu -->
            <xpath expr="//notebook" position="inside">
                <page string="VeriFactu"
                      name="verifacti"
                      invisible="move_type not in ['out_invoice', 'out_refund']">

                    <group>
                        <group name="verifacti_config" string="Configuración">
                            <field name="verifacti_tipo_factura"/>
                            <field name="verifacti_validar_destinatario"/>
                            <field name="verifacti_tipo_rectificativa"
                                   invisible="verifacti_tipo_factura not in ['R1', 'R2', 'R3', 'R4', 'R5']"/>
                            <field name="verifacti_incidencia"/>
                        </group>

                        <group name="verifacti_response" string="Respuesta VeriFactu">
                            <field name="verifacti_uuid" readonly="1"/>
                            <field name="verifacti_registration_status" readonly="1"/>
                            <field name="verifacti_huella" readonly="1"/>
                            <field name="verifacti_url" widget="url" readonly="1"/>
                        </group>
                    </group>

                    <group name="verifacti_qr" string="Código QR" invisible="not verifacti_qr">
                        <field name="verifacti_qr" widget="image" readonly="1"/>
                    </group>

                    <group name="verifacti_error" string="Errores" invisible="verifacti_state != 'error'">
                        <group>
                            <field name="verifacti_error_code" readonly="1"/>
                            <field name="verifacti_error_summary" readonly="1"/>
                        </group>
                        <group>
                            <field name="verifacti_error_message" readonly="1" widget="text"/>
                        </group>
                    </group>

                    <group name="verifacti_solution" string="Solución Sugerida" invisible="verifacti_state != 'error'">
                        <field name="verifacti_error_solution" readonly="1" widget="text" nolabel="1"/>
                    </group>

                    <notebook>
                        <page string="XML Petición" invisible="not verifacti_xml_request">
                            <field name="verifacti_xml_request" widget="ace" options="{'mode': 'xml'}" readonly="1"/>
                        </page>

                        <page string="XML Respuesta" invisible="not verifacti_xml_response">
                            <field name="verifacti_xml_response" widget="ace" options="{'mode': 'xml'}" readonly="1"/>
                        </page>

                        <page string="Respuesta API" invisible="not verifacti_api_response">
                            <field name="verifacti_api_response" widget="ace" options="{'mode': 'json'}" readonly="1"/>
                        </page>
                    </notebook>
                </page>
            </xpath>

        </field>
    </record>

    <!-- Vista Tree/List - Agregar columna de estado VeriFactu -->
    <record id="view_invoice_tree_verifacti" model="ir.ui.view">
        <field name="name">account.move.tree.verifacti</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_invoice_tree"/>
        <field name="arch" type="xml">
            <!-- Agregar campos al final de la lista -->
            <xpath expr="//list" position="inside">
                <field name="verifacti_state"
                    string="VeriFactu"
                    widget="badge"
                    decoration-success="verifacti_state=='correct'"
                    decoration-info="verifacti_state=='pending'"
                    decoration-warning="verifacti_state=='sent'"
                    decoration-danger="verifacti_state=='error'"
                    decoration-muted="verifacti_state in ['draft', 'cancelled']"
                    optional="show"/>
                <field name="verifacti_error_summary"
                    string="Error VeriFactu"
                    optional="hide"
                    invisible="verifacti_state != 'error'"/>
            </xpath>
        </field>
    </record>

    <!-- Filtros de búsqueda -->
    <record id="view_account_invoice_filter_verifacti" model="ir.ui.view">
        <field name="name">account.move.select.verifacti</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_account_invoice_filter"/>
        <field name="arch" type="xml">
            <!-- Agregar filtros de VeriFactu -->
            <xpath expr="//filter[@name='draft']" position="after">
                <separator/>
                <filter string="VeriFactu Pendiente"
                        name="verifacti_pending"
                        domain="[('verifacti_state', 'in', ['pending', 'sent'])]"/>
                <filter string="VeriFactu Correcto"
                        name="verifacti_correct"
                        domain="[('verifacti_state', '=', 'correct')]"/>
                <filter string="VeriFactu Error"
                        name="verifacti_error"
                        domain="[('verifacti_state', '=', 'error')]"/>
            </xpath>

            <!-- Agregar agrupación por estado VeriFactu -->
            <xpath expr="//search/group" position="inside">
                <filter string="Estado VeriFactu"
                        name="group_by_verifacti_state"
                        context="{'group_by': 'verifacti_state'}"/>
                <filter string="Tipo de Error"
                        name="group_by_error"
                        context="{'group_by': 'verifacti_error_summary'}"
                        domain="[('verifacti_state', '=', 'error')]"/>
            </xpath>
        </field>
    </record>

</odoo>