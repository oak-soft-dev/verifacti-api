<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Vista Form de Facturas - Extensión VeriFactu -->
    <record id="view_move_form_verifacti" model="ir.ui.view">
        <field name="name">account.move.form.verifacti</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <!-- Agregar campos invisibles necesarios para attrs -->
            <xpath expr="//field[@name='invoice_date']" position="before">
                <field name="type" invisible="1"/>
                <field name="verifacti_uuid" invisible="1"/>
                <field name="verifacti_qr" invisible="1"/>
            </xpath>

            <!-- Agregar botones en el header (solo para facturas de cliente) -->
            <xpath expr="//header" position="inside">
                <!-- Definir verifacti_state primero para usarlo en attrs de botones -->
                <field name="verifacti_state"
                       widget="statusbar"
                       statusbar_visible="draft,sent,pending,correct"
                       attrs="{'invisible': [('type', 'not in', ['out_invoice', 'out_refund'])]}"/>

                <button name="action_send_to_verifacti"
                        string="Enviar a VeriFactu"
                        type="object"
                        class="btn-primary"
                        attrs="{'invisible': ['|', '|', ('type', 'not in', ['out_invoice', 'out_refund']), ('state', '!=', 'posted'), '&amp;', ('verifacti_state', 'not in', ['draft', 'error']), ('type', '!=', 'out_refund')]}"
                        groups="base.group_user"/>

                <button name="action_check_verifacti_status"
                        string="Verificar Estado"
                        type="object"
                        attrs="{'invisible': ['|', ('type', 'not in', ['out_invoice', 'out_refund']), ('verifacti_uuid', '=', False)]}"
                        groups="base.group_user"/>

                <button name="action_download_verifacti_xmls"
                        string="Descargar XMLs"
                        type="object"
                        attrs="{'invisible': ['|', ('type', 'not in', ['out_invoice', 'out_refund']), ('verifacti_uuid', '=', False)]}"
                        groups="base.group_user"/>

                <button name="action_cancel_verifacti"
                        string="Anular en VeriFactu"
                        type="object"
                        confirm="¿Está seguro de que desea anular esta factura en VeriFactu?"
                        attrs="{'invisible': ['|', '|', ('type', 'not in', ['out_invoice', 'out_refund']), ('verifacti_uuid', '=', False), ('verifacti_state', '=', 'cancelled')]}"
                        groups="base.group_user"/>
            </xpath>

            <!-- Agregar botón inteligente para código QR -->
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_download_verifacti_xmls"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-qrcode"
                        attrs="{'invisible': [('verifacti_qr', '=', False)]}">
                    <div class="o_stat_info">
                        <span class="o_stat_text">QR VeriFactu</span>
                    </div>
                </button>
            </xpath>

            <!-- Agregar pestaña VeriFactu -->
            <xpath expr="//notebook" position="inside">
                <page string="VeriFactu"
                      name="verifacti"
                      attrs="{'invisible': [('type', 'not in', ['out_invoice', 'out_refund'])]}">

                    <group>
                        <group name="verifacti_config" string="Configuración">
                            <field name="verifacti_tipo_factura"/>
                            <field name="verifacti_validar_destinatario"/>
                            <field name="verifacti_tipo_rectificativa"
                                   attrs="{'invisible': [('verifacti_tipo_factura', 'not in', ['R1', 'R2', 'R3', 'R4', 'R5'])],
                                           'required': [('verifacti_tipo_factura', 'in', ['R1', 'R2', 'R3', 'R4', 'R5'])]}"/>
                            <field name="verifacti_incidencia"/>
                        </group>

                        <group name="verifacti_response" string="Respuesta VeriFactu">
                            <field name="verifacti_uuid" readonly="1"/>
                            <field name="verifacti_registration_status" readonly="1"/>
                            <field name="verifacti_huella" readonly="1"/>
                            <field name="verifacti_url" widget="url" readonly="1"/>
                        </group>
                    </group>

                    <group name="verifacti_qr" string="Código QR" attrs="{'invisible': ['|', ('verifacti_state', 'not in', ['pending', 'sent', 'correct']), ('verifacti_qr', '=', False)]}">
                        <field name="verifacti_qr" widget="image" readonly="1"/>
                        <div attrs="{'invisible': [('verifacti_state', '!=', 'pending')]}" class="alert alert-info">
                            El QR ya está disponible. La factura está siendo procesada por la AEAT.
                        </div>
                    </group>

                    <group name="verifacti_error" string="Errores" attrs="{'invisible': [('verifacti_state', '!=', 'error')]}">
                        <group>
                            <field name="verifacti_error_code" readonly="1"/>
                            <field name="verifacti_error_summary" readonly="1"/>
                        </group>
                        <group>
                            <field name="verifacti_error_message" readonly="1" widget="text"/>
                        </group>
                    </group>

                    <group name="verifacti_solution" string="Solución Sugerida" attrs="{'invisible': [('verifacti_state', '!=', 'error')]}">
                        <field name="verifacti_error_solution" readonly="1" widget="text" nolabel="1"/>
                    </group>

                    <notebook>
                        <page string="XML Petición" attrs="{'invisible': [('verifacti_xml_request', '=', False)]}">
                            <field name="verifacti_xml_request" widget="ace" options="{'mode': 'xml'}" readonly="1"/>
                        </page>

                        <page string="XML Respuesta" attrs="{'invisible': [('verifacti_xml_response', '=', False)]}">
                            <field name="verifacti_xml_response" widget="ace" options="{'mode': 'xml'}" readonly="1"/>
                        </page>

                        <page string="Respuesta API" attrs="{'invisible': [('verifacti_api_response', '=', False)]}">
                            <field name="verifacti_api_response" widget="ace" options="{'mode': 'json'}" readonly="1"/>
                        </page>
                    </notebook>
                </page>
            </xpath>

        </field>
    </record>

    <!-- Vista Tree - Agregar columna de estado VeriFactu -->
    <record id="view_invoice_tree_verifacti" model="ir.ui.view">
        <field name="name">account.move.tree.verifacti</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_invoice_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='state']" position="after">
                <field name="verifacti_state"/>
            </xpath>
        </field>
    </record>

</odoo>