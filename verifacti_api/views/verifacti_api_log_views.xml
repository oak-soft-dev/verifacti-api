<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Vista de formulario de log API -->
    <record id="view_verifacti_api_log_form" model="ir.ui.view">
        <field name="name">verifacti.api.log.form</field>
        <field name="model">verifacti.api.log</field>
        <field name="arch" type="xml">
            <form string="Log API Verifacti" create="false" edit="false" delete="false">
                <sheet>
                    <group>
                        <group>
                            <field name="endpoint"/>
                            <field name="method"/>
                            <field name="status_code"/>
                            <field name="duration"/>
                        </group>
                        <group>
                            <field name="create_date"/>
                            <field name="error" attrs="{'invisible': [('error', '=', False)]}"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Request">
                            <field name="request_data" widget="ace"
                                   options="{'mode': 'json'}"/>
                        </page>
                        <page string="Response">
                            <field name="response_data" widget="ace"
                                   options="{'mode': 'json'}"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Vista de lista de log API -->
    <record id="view_verifacti_api_log_tree" model="ir.ui.view">
        <field name="name">verifacti.api.log.tree</field>
        <field name="model">verifacti.api.log</field>
        <field name="arch" type="xml">
            <tree string="Log API Verifacti" create="false"
                  decoration-success="status_code &gt;= 200 and status_code &lt; 300"
                  decoration-danger="status_code &gt;= 400 or error"
                  decoration-muted="status_code == 0">
                <field name="create_date"/>
                <field name="method"/>
                <field name="endpoint"/>
                <field name="status_code"/>
                <field name="duration" widget="float_time"/>
                <field name="error"/>
            </tree>
        </field>
    </record>

    <!-- Vista de búsqueda -->
    <record id="view_verifacti_api_log_search" model="ir.ui.view">
        <field name="name">verifacti.api.log.search</field>
        <field name="model">verifacti.api.log</field>
        <field name="arch" type="xml">
            <search string="Buscar Log API">
                <field name="endpoint"/>
                <field name="method"/>
                <filter string="Con errores" name="with_errors" domain="[('error', '!=', False)]"/>
                <filter string="Éxito" name="success" domain="[('status_code', '&gt;=', 200), ('status_code', '&lt;', 300)]"/>
                <filter string="Hoy" name="today"
                        domain="[('create_date', '&gt;=', (context_today()).strftime('%Y-%m-%d'))]"/>
                <group expand="0" string="Agrupar por">
                    <filter string="Método" name="group_method" context="{'group_by': 'method'}"/>
                    <filter string="Endpoint" name="group_endpoint" context="{'group_by': 'endpoint'}"/>
                    <filter string="Código Estado" name="group_status" context="{'group_by': 'status_code'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Acción para abrir log API -->
    <record id="action_verifacti_api_log" model="ir.actions.act_window">
        <field name="name">Log API Verifacti</field>
        <field name="res_model">verifacti.api.log</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_verifacti_api_log_search"/>
        <field name="context">{'search_default_today': 1}</field>
    </record>
</odoo>
