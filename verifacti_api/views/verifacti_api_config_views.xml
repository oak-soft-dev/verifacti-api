<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Tree View -->
    <record id="view_verifacti_api_config_tree" model="ir.ui.view">
        <field name="name">verifacti.api.config.tree</field>
        <field name="model">verifacti.api.config</field>
        <field name="arch" type="xml">
            <tree string="Configuraciones API Verifacti">
                <field name="name"/>
                <field name="company_id"/>
                <field name="environment"/>
                <field name="is_default" widget="boolean_toggle"/>
                <field name="usage_count"/>
                <field name="last_used_date"/>
                <field name="active" widget="boolean_toggle"/>
            </tree>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_verifacti_api_config_form" model="ir.ui.view">
        <field name="name">verifacti.api.config.form</field>
        <field name="model">verifacti.api.config</field>
        <field name="arch" type="xml">
            <form string="Configuración API Verifacti">
                <header>
                    <button name="action_test_connection"
                            string="Probar Conexión"
                            type="object"
                            class="btn-primary"
                            icon="fa-plug"/>
                    <button name="action_set_as_default"
                            string="Marcar como Predeterminada"
                            type="object"
                            class="btn-secondary"
                            attrs="{'invisible': [('is_default', '=', True)]}"
                            icon="fa-star"/>
                    <button name="action_view_invoices"
                            string="Ver Facturas"
                            type="object"
                            class="btn-secondary"
                            attrs="{'invisible': [('invoice_count', '=', 0)]}"
                            icon="fa-file-invoice"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_invoices"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-file-invoice">
                            <field name="invoice_count" widget="statinfo" string="Facturas"/>
                        </button>
                    </div>

                    <widget name="web_ribbon" title="Por Defecto"
                            bg_color="bg-success"
                            attrs="{'invisible': [('is_default', '=', False)]}"/>

                    <widget name="web_ribbon" title="Archivado"
                            bg_color="bg-danger"
                            attrs="{'invisible': [('active', '=', True)]}"/>

                    <group>
                        <group name="basic_info" string="Información Básica">
                            <field name="name" placeholder="ej: Desarrollo, Producción, Testing"/>
                            <field name="company_id" options="{'no_create': True}"/>
                            <field name="environment"/>
                            <field name="is_default"/>
                            <field name="active"/>
                        </group>
                        <group name="api_info" string="Configuración API">
                            <field name="api_url"/>
                            <field name="api_key" password="True"/>
                        </group>
                    </group>

                    <group name="stats" string="Estadísticas de Uso">
                        <group>
                            <field name="usage_count" readonly="1"/>
                            <field name="last_used_date" readonly="1"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Notas" name="notes">
                            <field name="notes" placeholder="Notas adicionales sobre esta configuración..."/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_verifacti_api_config_search" model="ir.ui.view">
        <field name="name">verifacti.api.config.search</field>
        <field name="model">verifacti.api.config</field>
        <field name="arch" type="xml">
            <search string="Buscar Configuraciones API">
                <field name="name" string="Nombre" filter_domain="[('name', 'ilike', self)]"/>
                <field name="company_id"/>
                <filter string="Configuraciones por Defecto" name="default_configs" domain="[('is_default', '=', True)]"/>
                <filter string="Producción" name="production" domain="[('environment', '=', 'production')]"/>
                <filter string="Pruebas" name="test" domain="[('environment', '=', 'test')]"/>
                <separator/>
                <filter string="Activas" name="active" domain="[('active', '=', True)]"/>
                <filter string="Archivadas" name="inactive" domain="[('active', '=', False)]"/>
                <group expand="0" string="Agrupar por">
                    <filter string="Compañía" name="group_by_company" context="{'group_by': 'company_id'}"/>
                    <filter string="Entorno" name="group_by_environment" context="{'group_by': 'environment'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_verifacti_api_config" model="ir.actions.act_window">
        <field name="name">Configuraciones API</field>
        <field name="res_model">verifacti.api.config</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'search_default_active': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Crear una nueva configuración de API Verifacti
            </p>
            <p>
                Las configuraciones de API le permiten gestionar múltiples tokens de API
                para diferentes entornos (desarrollo, producción) por compañía.
            </p>
        </field>
    </record>

</odoo>
