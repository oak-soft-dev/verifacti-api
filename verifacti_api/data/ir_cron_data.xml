<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Cron para verificar estado de facturas pendientes -->
        <record id="ir_cron_check_registration_status" model="ir.cron">
            <field name="name">Verifacti: Verificar Estado de Registros Pendientes</field>
            <field name="model_id" ref="model_verifacti_invoice"/>
            <field name="state">code</field>
            <field name="code">model.cron_check_pending_registrations()</field>
            <field name="interval_number">5</field>
            <field name="interval_type">minutes</field>
            <field name="numbercall">-1</field>
            <field name="active" eval="True"/>
            <field name="doall" eval="False"/>
        </record>
    </data>
</odoo>
