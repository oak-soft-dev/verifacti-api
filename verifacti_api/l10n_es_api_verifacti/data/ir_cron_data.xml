<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="ir_cron_send_pending" model="ir.cron">
            <field name="name">VeriFactu: enviar registros pendientes a la AEAT</field>
            <field name="model_id" ref="model_l10n_es_verifacti_registro"/>
            <field name="state">code</field>
            <field name="code">model._cron_send_pending()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
        </record>

        <record id="ir_cron_vacuum_logs" model="ir.cron">
            <field name="name">VeriFactu: purgar logs de la API (&gt;90 días)</field>
            <field name="model_id" ref="model_l10n_es_verifacti_request_log"/>
            <field name="state">code</field>
            <field name="code">model._cron_vacuum()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
